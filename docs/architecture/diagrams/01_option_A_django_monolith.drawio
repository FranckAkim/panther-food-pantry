" y="376" width="214" height="56" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Report views&lt;/b&gt;&lt;br&gt;dashboard · CSV export" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="376" width="214" height="56" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Django ORM&lt;/b&gt;&lt;br&gt;transaction.atomic() around each action · writes audit_log" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="446" y="462" width="448" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;send_mail() in an on_commit hook&lt;/b&gt;&lt;br&gt;same process, short timeout — no queue, no worker" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="446" y="542" width="448" height="50" as="geometry"/></mxCell><mxCell id="c19" value="DATA" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=3;fillColor=#FFF5E6;strokeColor=#B26B00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#B26B00;" vertex="1" parent="1"><mxGeometry x="980" y="116" width="580" height="220" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;PostgreSQL (managed)&lt;/b&gt;&lt;br&gt;users · student_profiles&lt;br&gt;requests · pickup_slots&lt;br&gt;items · lots · donations&lt;br&gt;distributions · audit_log" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;shape=cylinder3;boundedLbl=1;size=12;fillColor=#FFFFFF;strokeColor=#B26B00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="146" width="250" height="172" as