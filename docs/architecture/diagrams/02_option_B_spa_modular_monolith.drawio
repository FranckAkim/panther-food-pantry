style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="553" y="276"/></Array></mxGeometry></mxCell><mxCell id="c33" value="3" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="542" y="265" width="22" height="22" as="geometry"/></mxCell><mxCell id="c34" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="436" y="334"/><mxPoint x="436" y="487"/></Array></mxGeometry></mxCell><mxCell id="c35" value="4" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430" y="338" width="22" height="22" as="geometry"/></mxCell><mxCell id="c36" value="SQL / TLS" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="946" y="487"/><mxPoint x="946" y="232"/></Array></mxGeometry></mxCell><mxCell id="c37" value="5" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="903" y="461" width="22" height="22" as="geometry"/></mxCell><mxCell id="c38" value="after commit" style="html=1;rounded=0;endArrow=open;endFill=0;strokeColor=#7A4FB0;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#7A4FB0;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="670" y="512"/></Array></mxGeometry></mxCell><mxCell id="c39" value="6" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="659" y="501" width="22" height="22" as="geometry"/></mxCell><mxCell id="c40" value="HTTPS API" style="html=1;rounded=0;endArrow=open;endFill=0;strokeColor=#7A4FB0;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#7A4FB0;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c18" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="962" y="567"/><mxPoint x="962" y="435"/></Array></mxGeometry></mxCell><mxCell id="c41" value="7" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="903" y="541" width="22" height="22" as="geometry"/></mxCell><mxCell id="c42" value="CD: deploy new image on merge to main" style="html=1;rounded=0;endArrow=open;endFill=0;strokeColor=#7A4FB0;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#7A4FB0;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c26" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1575" y="444"/><mxPoint x="1575" y="88"/><mxPoint x="800" y="88"/></Array></mxGeometry></mxCell><mxCell id="c43" value="GET /health" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c27" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="655"/><mxPoint x="670" y="655"/></Array></mxGeometry></mxCell><mxCell id="c44" value="&lt;b&gt;Main workflow — student submits a food request&lt;/b&gt;&lt;br&gt;1.  Browser downloads the React app once from the same container (same origin → no CORS setup).&lt;br&gt;2.  SPA sends POST /api/requests with a JSON body; the httpOnly session cookie travels automatically.&lt;br&gt;3.  Auth guard loads the session, confirms role = student, and hands the call to the Requests module.&lt;br&gt;4.  Requests module validates the chosen pickup slot (capacity, not in the past) and calls the data layer.&lt;br&gt;5.  One PostgreSQL transaction inserts the request + an audit_log row: both commit, or neither does.&lt;br&gt;6.  API returns 201 Created to the browser; only then is the email task started (asynchronous).&lt;br&gt;7.  Email API sends the confirmation. If it fails, the error is logged; the request itself still exists." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1000" height="200" as="geometry"/></mxCell><mxCell id="c45" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1060" y="680" width="500" height="200" as="geometry"/></mxCell><mxCell id="c46" value="Legend" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=top;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1072" y="688" width="200" height="20" as="geometry"/></mxCell><mxCell id="c47" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edg