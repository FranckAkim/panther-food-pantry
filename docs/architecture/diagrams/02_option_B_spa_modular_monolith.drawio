<mxfile host="app.diagrams.net" agent="generated"><diagram name="Option B — SPA + modular monolith API" id="60c546952e3b539ab6bb"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Option B — React SPA + FastAPI modular monolith + PostgreSQL   (recommended)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=24;align=left;verticalAlign=top;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c2" value="One deployable container serves both the web app and the JSON API · same origin, so cookies work without CORS · Panther Food Pantry Management System" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=top;fontStyle=0;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c3" value="CLIENT — user devices" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=3;fillColor=#EEF4FF;strokeColor=#3E6AA8;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#3E6AA8;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="300" height="504" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Student&lt;/b&gt;&lt;br&gt;phone / laptop" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="56" y="170" width="122" height="64" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Staff / Admin&lt;/b&gt;&lt;br&gt;desk tablet" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="56" y="290" width="122" height="64" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;React SPA&lt;/b&gt;&lt;br&gt;(Vite build)&lt;br&gt;&lt;br&gt;runs in the&lt;br&gt;browser&lt;br&gt;&lt;br&gt;screens shown&lt;br&gt;by role&lt;br&gt;&lt;br&gt;calls /api/*&lt;br&gt;with JSON" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="198" y="150" width="126" height="450" as="geometry"/></mxCell><mxCell id="c7" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="Render web service · 1 Docker container · HTTPS" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=2;fillColor=none;strokeColor=#4B5563;dashed=1;dashPattern=8 4;strokeWidth=1.5;verticalAlign=top;align=right;spacingRight=10;spacingTop=2;fontSize=11;fontStyle=2;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="520" height="544" as="geometry"/></mxCell><mxCell id="c10" value="APPLICATION — FastAPI (Python), one codebase" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=3;fillColor=#EDF7EE;strokeColor=#2F7D3A;strokeWidth=1.5;vertica