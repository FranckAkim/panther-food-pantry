width="214" height="56" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Reports &amp;amp; Dashboard&lt;/b&gt;&lt;br&gt;low stock · expiring · CSV" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="376" width="214" height="56" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Data access layer (SQLAlchemy)&lt;/b&gt;&lt;br&gt;one DB transaction per API call · writes audit_log" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="446" y="462" width="448" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Background task (runs after commit)&lt;/b&gt;&lt;br&gt;sends email; a failure is logged, never shown as a failed request" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="446" y="542" width="448" height="50" as="geometry"/></mxCell><mxCell id="c19" value="DATA" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=3;fillColor=#FFF5E6;strokeColor=#B26B00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#B26B00;" vertex="1" parent="1"><mxGeometry x="980" y="116" width="580" height="220" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;PostgreSQL (managed)&lt;/b&gt;&lt;br&gt;users · student_profiles&lt;br&gt;requests · pickup_slots&lt;br&gt;items · lots · donations&lt;br&gt;distributions · audit_log" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;shape=cylinder3;boundedLbl=1;size=12;fillColor=#FFFFFF;strokeColor=#B26B00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="146" width="250" height="172" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Backups&lt;/b&gt;&lt;br&gt;provider daily snapshot&lt;br&gt;+ nightly pg_dump job&lt;br&gt;(GitHub Actions)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B26B00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="182" width="240" height="96" as="geometry"/></mxCell><mxCell id="c22" value="copy" style="html=1;rounded=0;endArrow=open;endFill=0;strokeColor=#7A4FB0;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#7A4FB0;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="EXTERNAL SERVICES" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=3;fillColor=#F3EEFA;strokeColor=#6A4A9C;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#6A4A9C;" vertex="1" parent="1"><mxGeometry x="980" y="356" width="580" height="264" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Transactional email API&lt;/b&gt;&lt;br&gt;confirmations · reminders" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#6A4A9C;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="400" width="240" height="70" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Render log stream&lt;/b&gt;&lt;br&gt;app writes JSON logs to stdout;&lt;br&gt;team reads them in dashboard" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#6A4A9C;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="500" width="240" height="84" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;GitHub + GitHub Actions&lt;/b&gt;&