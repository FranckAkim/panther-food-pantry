try relative="1" as="geometry"><Array as="points"><mxPoint x="1230" y="188"/></Array></mxGeometry></mxCell><mxCell id="c33" value="5" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1219" y="177" width="22" height="22" as="geometry"/></mxCell><mxCell id="c34" value="row inserted" style="html=1;rounded=0;endArrow=open;endFill=0;strokeColor=#7A4FB0;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#7A4FB0;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1115" y="306"/></Array></mxGeometry></mxCell><mxCell id="c35" value="6" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1104" y="295" width="22" height="22" as="geometry"/></mxCell><mxCell id="c36" value="HTTP POST" style="html=1;rounded=0;endArrow=open;endFill=0;strokeColor=#7A4FB0;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#7A4FB0;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c18" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="400"/></Array></mxGeometry></mxCell><mxCell id="c37" value="7" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="989" y="389" width="22" height="22" as="geometry"/></mxCell><mxCell id="c38" value="send" style="html=1;rounded=0;endArrow=open;endFill=0;strokeColor=#7A4FB0;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#7A4FB0;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c13" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="865" y="430"/></Array></mxGeometry></mxCell><mxCell id="c39" value="8" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="854" y="419" width="22" height="22" as="geometry"/></mxCell><mxCell id="c40" value="migrations" style="html=1;rounded=0;endArrow=open;endFill=0;strokeColor=#7A4FB0;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#7A4FB0;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c22"><mxGeometry relative="1" as="geometry"><mxPoint x="1155" y="476" as="targetPoint"/><Array as="points"><mxPoint x="1155" y="522"/></Array></mxGeometry></mxCell><mxCell id="c41" value="" style="html=1;rounded=0;endArrow=open;endFill=0;strokeColor=#7A4FB0;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#7A4FB0;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c22" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1155" y="608"/><mxPoint x="571" y="608"/></Array></mxGeometry></mxCell><mxCell id="c42" value="&lt;b&gt;Main workflow — student submits a food request&lt;/b&gt;&lt;br&gt;1.  Browser downloads the SPA from the static host / CDN (no application server involved).&lt;br&gt;2.  Student signs in with Supabase Auth and receives a JWT — a signed token stating who they are.&lt;br&gt;3.  SPA calls the auto-generated API directly: POST /rest/v1/requests, with the JWT attached.&lt;br&gt;4.  PostgREST runs the INSERT inside Postgres as the “authenticated” role, carrying the user id.&lt;br&gt;5.  Row-Level Security policy checks auth.uid() and role; a student cannot write another student’s row.&lt;br&gt;6.  On commit, a database webhook fires for the new row (asynchronous — the student already has the reply).&lt;br&gt;7.  The webhook calls the notify-student Edge Function over HTTPS.&lt;br&gt;8.  The Edge Function calls the email API to send the confirmation." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1000" height="200" as="geometry"/></mxCell><mxCell id="c43" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1060" y="680" width="500" height="200" as="geometry"/></mxCell><mxCell id="c44" value="Legend" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=top;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1072" y="688" width="200" height="20" as="geometry"/></mxCell><mxCell id="c45" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1076" y="724" as="sourcePoint"/><mxPoint x="1146" y="724" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="Synchronous request/response" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontStyle=0;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1156" y="715" width="170" height="18" as="geometry"/></mxCell><mxCell id="c47" value="" style="html=1;rounded=0;endArrow=open;endFill=0;strokeColor=#7A4FB0;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#7A4FB0;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1076" y="752" as="sourcePoint"/><mxPoint x="1146" y="752" as="targetPoint"/></mxGeometry></mx