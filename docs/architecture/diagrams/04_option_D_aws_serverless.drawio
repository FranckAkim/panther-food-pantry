="1166" y="474" width="180" height="64" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;logs · metrics · alarms" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#6A4A9C;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1366" y="474" width="180" height="64" as="geometry"/></mxCell><mxCell id="c28" value="Secrets Manager — DB credentials, never in code" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#6A4A9C;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1166" y="552" width="380" height="52" as="geometry"/></mxCell><mxCell id="c29" value="GET /" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="324" y="182"/></Array></mxGeometry></mxCell><mxCell id="c30" value="1" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="313" y="171" width="22" height="22" as="geometry"/></mxCell><mxCell id="c31" value="sign in" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="324" y="272"/></Array></mxGeometry></mxCell><mxCell id="c32" value="2" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="313" y="261" width="22" height="22" as="geometry"/></mxCell><mxCell id="c33" value="POST /requests" style="html=1