nt="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="event" style="html=1;rounded=0;endArrow=open;endFill=0;strokeColor=#7A4FB0;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#7A4FB0;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="795" y="420"/></Array></mxGeometry></mxCell><mxCell id="c41" value="6" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="784" y="409" width="22" height="22" as="geometry"/></mxCell><mxCell id="c42" value="" style="html=1;rounded=0;endArrow=open;endFill=0;strokeColor=#7A4FB0;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#7A4FB0;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="502"/></Array></mxGeometry></mxCell><mxCell id="c43" value="7" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="889" y="491" width="22" height="22" as="geometry"/></mxCell><mxCell id="c44" value="" style="html=1;rounded=0;endArrow=open;endFill=0;strokeColor=#7A4FB0;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#7A4FB0;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c19" target="c26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1106" y="506"/></Array></mxGeometry></mxCell><mxCell id="c45" value="8" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1095" y="495" width="22" height="22" as="geometry"/></mxCell><mxCell id="c46" value="daily" style="html=1;rounded=0;endArrow=open;endFill=0;strokeColor=#7A4FB0;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#7A4FB0;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="551" y="582"/></Array></mxGeometry></mxCell><mxCell id="c47" value="deploy" style="html=1;rounded=0;endArrow=open;endFill=0;strokeColor=#7A4FB0;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#7A4FB0;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="324" y="576"/><mxPoint x="410" y="576"/></Array></mxGeometry></mxCell><mxCell id="c48" value="&lt;b&gt;Main workflow — student submits a food request&lt;/b&gt;&lt;br&gt;1.  Browser downloads the SPA from CloudFront (CDN) backed by an S3 bucket.&lt;br&gt;2.  Student signs in with Cognito and receives a JWT.&lt;br&gt;3.  SPA sends POST /requests to API Gateway; its JWT authorizer rejects missing or invalid tokens.&lt;br&gt;4.  API Gateway invokes the Requests Lambda function (code runs only while handling the call).&lt;br&gt;5.  The function writes request + audit_log in one transaction via RDS Proxy (avoids exhausting DB connections).&lt;br&gt;6.  The function publishes a RequestSubmitted event and returns 201 — it does not wait for email.&lt;br&gt;7.  EventBridge routes the event to the Notify Lambda (retries automatically on failure).&lt;br&gt;8.  Notify Lambda calls SES to send the confirmation email." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1000" height="200" as="geometry"/></mxCell><mxCell id="c49" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fo