="&lt;b&gt;Lambda functions&lt;/b&gt;&lt;br&gt;requests · inventory&lt;br&gt;distribution · reports&lt;br&gt;(Python, one per module)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="320" width="210" height="100" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;EventBridge event bus&lt;/b&gt;&lt;br&gt;RequestSubmitted, …" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="470" width="210" height="64" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;EventBridge Scheduler&lt;/b&gt;&lt;br&gt;daily 07:00 expiry scan" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="446" y="470" width="210" height="64" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Notify Lambda&lt;/b&gt;&lt;br&gt;builds the email" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="934" y="470" width="172" height="64" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Expiry-check Lambda&lt;/b&gt;&lt;br&gt;queries DB, alerts staff" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="934" y="556" width="172" height="52" as="geometry"/></mxCell><mxCell id="c21" value="DATA" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=3;fillColor=#FFF5E6;strokeColor=#B26B00;strokeWidth=1.5;verticalAlign=top;align=left;spacin