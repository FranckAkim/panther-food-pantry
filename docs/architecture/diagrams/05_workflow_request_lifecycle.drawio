<mxfile host="app.diagrams.net" agent="generated"><diagram name="Workflow — request lifecycle" id="6aef8768e2675fefbcb8"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Workflow view — life of a food request (recommended design, all options share it)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=24;align=left;verticalAlign=top;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c2" value="Each box is a status stored in requests.status · arrows are the ONLY allowed changes · [who] moves it · thick border = final state" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=top;fontStyle=0;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Student submits&lt;/b&gt;&lt;br&gt;request + pickup slot" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="160" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;SUBMITTED&lt;/b&gt;&lt;br&gt;waiting for staff" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="290" width="180" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;APPROVED&lt;/b&gt;&lt;br&gt;slot confirmed" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="290" width="180" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;COMPLETED&lt;/b&gt;&lt;br&gt;food handed over" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="290" width="200" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;DECLINED&lt;/b&gt;&lt;br&gt;reason stored" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="130" width="180" height="64" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;CANCELLED&lt;/b&gt;&lt;br&gt;by the student" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="480" width="180" height="64" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;NO_SHOW&lt;/b&gt;&lt;br&gt;slot missed" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="480" width="180" height="64" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Walk-in student&lt;/b&gt;&lt;br&gt;no request made in advance" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="110" width="200" height="70" as="geometry"/></mxCell><mxCell id="c11" value="[Student] submit" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="[Staff] approve" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="[Staff] record distribution&lt;br&gt;(stock decremented in the&lt;br&gt;same transaction)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="[Staff] decline&lt;br&gt;(reason required)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="[Student] cancel" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="512"/></Array></mxGeometry></mxCell><mxCell id="c16" value="[Student] cancel&lt;br&gt;≥ 2 h before slot" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="420"/><mxPoint x="660" y="470"/></Array></mxGeometry></mxCell><mxCell id="c17" value="[Staff] mark no-show&lt;br&gt;slot end + 30 min" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="420"/><mxPoint x="1000" y="470"/></Array></mxGeometry></mxCell><mxCell id="c18" value="[Staff] walk-in: request created&lt;br&gt;and completed in one step" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;Why a state machine?&lt;/b&gt;&lt;br&gt;It turns vague words&lt;br&gt;(“process the request”)&lt;br&gt;into testable rules:&lt;br&gt;&lt;br&gt;every arrow = 1 API&lt;br&gt;action = 1 test case;&lt;br&gt;anything else is&lt;br&gt;rejected with&lt;br&gt;409 Conflict." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1390" y="110" width="180" height="180" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Rules the API enforces&lt;/b&gt;&lt;br&gt;•  Only the arrows shown are allowed; any other change returns 409 Conflict.&lt;br&gt;•  A student can have at most ONE open request (SUBMITTED or APPROVED) at a time.&lt;br&gt;•  A pickup slot cannot exceed its capacity; slots in the past cannot be chosen.&lt;br&gt;•  Every change writes an audit_log row: who, when, from-status → to-status.&lt;br&gt;•  Final states (thick border) never change again.&lt;br&gt;•  Email (async, Should-have): on APPROVED, on DECLINED, and 24 h before the slot." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="760" height="140" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;FR-y — student arrives with no account (team decision)&lt;/b&gt;&lt;br&gt;Staff create a PROVISIONAL student profile: full name + student ID, checked&lt;br&gt;against the physical ID card. The distribution is recorded against that profile,&lt;br&gt;so inventory stays correct. When the student later registers with the same&lt;br&gt;student ID, the profile is linked to the new account and keeps its history.&lt;br&gt;Principle: nobody leaves without food because of the software." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="820" y="600" width="740" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>