<mxfile host="app.diagrams.net" agent="generated"><diagram name="Workflow — distribution transaction" id="cd22b2f01b9352b2a400"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Workflow view — recording a distribution without ever breaking the stock count" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=24;align=left;verticalAlign=top;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c2" value="Sequence diagram: time flows downward · the most important transaction in the system · shown for Option B (FastAPI + PostgreSQL)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=top;fontStyle=0;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Staff screen (React SPA)&lt;/b&gt;&lt;br&gt;at the pantry desk" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="240" height="56" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Distribution module&lt;/b&gt;&lt;br&gt;(FastAPI)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="100" width="240" height="56" as="geometry"/></mxCell><mxCell id="c5" value="PostgreSQL" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;shape=cylinder3;boundedLbl=1;size=12;fillColor=#FFFFFF;strokeColor=#B26B00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="92" width="220" height="74" as="geometry"/></mxCell><mxCell id="c6" value="" style="html=1;strokeColor=none;fillColor=#9CA3AF;" vertex="1" parent="1"><mxGeometry x="189" y="166" width="2" height="560" as="geometry"/></mxCell><mxCell id="c7" value="" style="html=1;strokeColor=none;fillColor=#9CA3AF;" vertex="1" parent="1"><mxGeometry x="619" y="166" width="2" height="560" as="geometry"/></mxCell><mxCell id="c8" value="" style="html=1;strokeColor=none;fillColor=#9CA3AF;" vertex="1" parent="1"><mxGeometry x="1059" y="166" width="2" height="560" as="geometry"/></mxCell><mxCell id="c9" value="POST /api/distributions  {request_id, items: [{item_id, qty}]}" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="210" as="sourcePoint"/><mxPoint x="620" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="1" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="201" y="183" width="22" height="22" as="geometry"/></mxCell><mxCell id="c11" value="BEGIN" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="260" as="sourcePoint"/><mxPoint x="1060" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="2" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="631" y="233" width="22" height="22" as="geometry"/></mxCell><mxCell id="c13" value="SELECT … FROM lots WHERE item_id = ? AND qty_on_hand &amp;gt; 0&lt;br&gt;ORDER BY expires_on  FOR UPDATE      (oldest first + row lock)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="320" as="sourcePoint"/><mxPoint x="1060" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="3" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="631" y="283" width="22" height="22" as="geometry"/></mxCell><mxCell id="c15" value="locked lots, soonest-expiring first" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="375" as="sourcePoint"/><mxPoint x="620" y="375" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="4" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1027" y="348" width="22" height="22" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Enough stock across those lots?&lt;/b&gt;&lt;br&gt;NO → ROLLBACK, reply 409 Conflict “only N left” (nothing saved)&lt;br&gt;YES → continue" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="634" y="400" width="400" height="66" as="geometry"/></mxCell><mxCell id="c18" value="UPDATE lots SET qty_on_hand = qty_on_hand − n     (CHECK qty_on_hand ≥ 0)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="500" as="sourcePoint"/><mxPoint x="1060" y="500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="5" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="631" y="473" width="22" height="22" as="geometry"/></mxCell><mxCell id="c20" value="INSERT distributions, distribution_lines, inventory_txns, audit_log&lt;br&gt;UPDATE requests SET status = &amp;#x27;COMPLETED&amp;#x27;" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="560" as="sourcePoint"/><mxPoint x="1060" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="6" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="631" y="523" width="22" height="22" as="geometry"/></mxCell><mxCell id="c22" value="COMMIT   (all of steps 5–6 become visible at once)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="620" as="sourcePoint"/><mxPoint x="1060" y="620" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="7" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="631" y="593" width="22" height="22" as="geometry"/></mxCell><mxCell id="c24" value="201 Created + receipt (items, lots, quantities)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="680" as="sourcePoint"/><mxPoint x="190" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="8" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="587" y="653" width="22" height="22" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;THE INVARIANT&lt;/b&gt;&lt;br&gt;For every lot, at every moment:&lt;br&gt;  0 ≤ qty_on_hand&lt;br&gt;  qty_on_hand = Σ inventory_txns.delta&lt;br&gt;&lt;br&gt;Enforced three independent ways:&lt;br&gt;&lt;br&gt;1)  Row lock (FOR UPDATE): if two staff&lt;br&gt;     hand out the last box at the same&lt;br&gt;     time, the second one waits, then&lt;br&gt;     sees 0 and gets 409 — no double sale.&lt;br&gt;&lt;br&gt;2)  CHECK constraint: the database itself&lt;br&gt;     refuses a negative number, even if&lt;br&gt;     our code has a bug.&lt;br&gt;&lt;br&gt;3)  One transaction: stock change and&lt;br&gt;     distribution record are saved&lt;br&gt;     together or not at all." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1210" y="100" width="350" height="330" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;FEFO = First Expired, First Out&lt;/b&gt;&lt;br&gt;The API picks lots by soonest expiry&lt;br&gt;date, which directly serves the&lt;br&gt;proposal’s goal of reducing food waste&lt;br&gt;(P §6)." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1210" y="450" width="350" height="110" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;Black arrow = a call;  grey arrow = the reply;  vertical grey lines = each participant over time.&lt;br&gt;This diagram is the answer to “what happens if two people take the last item at once?”" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1000" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>