<mxfile host="app.diagrams.net" agent="generated"><diagram name="Data model" id="a0cea547fd3954899076"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Data model — PostgreSQL tables shared by all four options" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=24;align=left;verticalAlign=top;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c2" value="PK = primary key · FK = foreign key (link to another table) · labels show cardinality, e.g. 1 — N = one row links to many rows" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=top;fontStyle=0;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;email  UNIQUE&lt;br&gt;password_hash  (argon2)&lt;br&gt;role  student | staff | admin&lt;br&gt;is_active&lt;br&gt;created_at" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="340" height="122" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;student_profiles&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;user_id  FK → users   (NULL = provisional)&lt;br&gt;student_id_no  UNIQUE&lt;br&gt;full_name&lt;br&gt;verified_by  FK → users (staff)&lt;br&gt;verified_at" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="340" height="122" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;audit_log&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;actor_id  FK → users&lt;br&gt;action  e.g. request.approve&lt;br&gt;entity, entity_id&lt;br&gt;details  JSON&lt;br&gt;at  (timestamp)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="340" height="122" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;pickup_slots&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;starts_at, ends_at&lt;br&gt;capacity  CHECK &amp;gt; 0" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="340" height="77" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;requests&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;student_profile_id  FK&lt;br&gt;slot_id  FK  (NULL for walk-in)&lt;br&gt;status  SUBMITTED | APPROVED | …&lt;br&gt;note&lt;br&gt;decided_by  FK → users, decided_at&lt;br&gt;created_at" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="430" y="260" width="340" height="137" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;distributions&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;request_id  FK  UNIQUE&lt;br&gt;student_profile_id  FK&lt;br&gt;staff_id  FK → users&lt;br&gt;distributed_at" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="430" y="560" width="340" height="107" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;items  (catalog)&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;name, category&lt;br&gt;unit  e.g. can, box, lb&lt;br&gt;low_stock_threshold" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#B26B00;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="340" height="92" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;lots  (physical stock)&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;item_id  FK&lt;br&gt;donation_id  FK  (NULL = purchased)&lt;br&gt;qty_on_hand  CHECK ≥ 0&lt;br&gt;received_on, expires_on&lt;br&gt;location  shelf / bin" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#B26B00;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="820" y="270" width="340" height="122" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;distribution_lines&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;distribution_id  FK&lt;br&gt;lot_id  FK&lt;br&gt;qty  CHECK &amp;gt; 0" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="820" y="560" width="340" height="92" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;donors&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;name&lt;br&gt;type  person | org | food drive&lt;br&gt;contact  (optional)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#6A4A9C;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft