source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="1 — N" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="1 — N" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1185" y="420"/><mxPoint x="1185" y="610"/><mxPoint x="1210" y="610"/></Array></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;Design notes&lt;/b&gt;&lt;br&gt;Items vs. lots: an item is “canned beans”; a lot is one delivery of it with its own expiry date and shelf. Expiry and FEFO only work at lot level.&lt;br&gt;qty_on_hand is a fast running total; inventory_txns is the ledger that explains every change. A test checks that both always agree." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1520" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>