metry x="1388" y="717" width="180" height="18" as="geometry"/></mxCell><mxCell id="c63" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=3;fillColor=#EDF7EE;strokeColor=#2F7D3A;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#2F7D3A;" vertex="1" parent="1"><mxGeometry x="1350" y="746" width="28" height="20" as="geometry"/></mxCell><mxCell id="c64" value="Application tier" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontStyle=0;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1388" y="747" width="180" height="18" as="geometry"/></mxCell><mxCell id="c65" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=3;fillColor=#FFF5E6;strokeColor=#B26B00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#B26B00;" vertex="1" parent="1"><mxGeometry x="1350" y="776" width="28" height="20" as="geometry"/></mxCell><mxCell id="c66" value="Data tier" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontStyle=0;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1388" y="777" width="180" height="18" as="geometry"/></mxCell><mxCell id="c67" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=3;fillColor=#F3EEFA;strokeColor=#6A4A9C;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#6A4A9C;" vertex="1" parent="1"><mxGeometry x="1350" y="806" width="28" height="20" as="geometry"/></mxCell><mxCell id="c68" value="External / managed services" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontStyle=0;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1388" y="807" width="180" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Workflow — request lifecycle" id="6aef8768e2675fefbcb8"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Workflow view — life of a food request (recommended design, all options share it)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=24;align=left;verticalAlign=top;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c2" value="Each box is a status stored in requests.status · arrows are the ONLY allowed changes · [who] moves it · thick border = final state" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=top;fontStyle=0;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Student submits&lt;/b&gt;&lt;br&gt;request + pickup slot" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="160" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;SUBMITTED&lt;/b&gt;&lt;br&gt;waiting for staff" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="290" width="180" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;APPROVED&lt;/b&gt;&lt;br&gt;slot confirmed" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="290" width="180" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;COMPLETED&lt;/b&gt;&lt;br&gt;food handed over" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="290" width="200" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;DECLINED&lt;/b&gt;&lt;br&gt;reason stored" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="130" width="180" height="64" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;CANCELLED&lt;/b&gt;&lt;br&gt;by the student" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="480" width="180" height="64" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;NO_SHOW&lt;/b&gt;&lt;br&gt;slot missed" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="480" width="180" height="64" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Walk-in student&lt;/b&gt;&lt;br&gt;no request made in advance" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="110" width="200" height="70" as="geometry"/></mxCell><mxCell id="c11" value="[Student] submit" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="[Staff] approve" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="[Staff] record distribution&lt;br&gt;(stock decremented in the&lt;br&gt;same transaction)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="[Staff] decline&lt;br&gt;(reason required)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="[Student] cancel" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="512"/></Array></mxGeometry></mxCell><mxCell id="c16" value="[Student] cancel&lt;br&gt;≥ 2 h before slot" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="420"/><mxPoint x="660" y="470"/></Array></mxGeometry></mxCell><mxCell id="c17" value="[Staff] mark no-show&lt;br&gt;slot end + 30 min" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="420"/><mxPoint x="1000" y="470"/></Array></mxGeometry></mxCell><mxCell id="c18" value="[Staff] walk-in: request created&lt;br&gt;and completed in one step" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;Why a state machine?&lt;/b&gt;&lt;br&gt;It turns vague words&lt;br&gt;(“process the request”)&lt;br&gt;into testable rules:&lt;br&gt;&lt;br&gt;every arrow = 1 API&lt;br&gt;action = 1 test case;&lt;br&gt;anything else is&lt;br&gt;rejected with&lt;br&gt;409 Conflict." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1390" y="110" width="180" height="180" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Rules the API enforces&lt;/b&gt;&lt;br&gt;•  Only the arrows shown are allowed; any other change returns 409 Conflict.&lt;br&gt;•  A student can have at most ONE open request (SUBMITTED or APPROVED) at a time.&lt;br&gt;•  A pickup slot cannot exceed its capacity; slots in the past cannot be chosen.&lt;br&gt;•  Every change writes an audit_log row: who, when, from-status → to-status.&lt;br&gt;•  Final states (thick border) never change again.&lt;br&gt;•  Email (async, Should-have): on APPROVED, on DECLINED, and 24 h before the slot." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="760" height="140" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;FR-y — student arrives with no account (team decision)&lt;/b&gt;&lt;br&gt;Staff create a PROVISIONAL student profile: full name + student ID, checked&lt;br&gt;against the physical ID card. The distribution is recorded against that profile,&lt;br&gt;so inventory stays correct. When the student later registers with the same&lt;br&gt;student ID, the profile is linked to the new account and keeps its history.&lt;br&gt;Principle: nobody leaves without food because of the software." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="820" y="600" width="740" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Workflow — distribution transaction" id="cd22b2f01b9352b2a400"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Workflow view — recording a distribution without ever breaking the stock count" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=24;align=left;verticalAlign=top;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c2" value="Sequence diagram: time flows downward · the most important transaction in the system · shown for Option B (FastAPI + PostgreSQL)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=top;fontStyle=0;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Staff screen (React SPA)&lt;/b&gt;&lt;br&gt;at the pantry desk" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="240" height="56" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Distribution module&lt;/b&gt;&lt;br&gt;(FastAPI)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="100" width="240" height="56" as="geometry"/></mxCell><mxCell id="c5" value="PostgreSQL" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;shape=cylinder3;boundedLbl=1;size=12;fillColor=#FFFFFF;strokeColor=#B26B00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="92" width="220" height="74" as="geometry"/></mxCell><mxCell id="c6" value="" style="html=1;strokeColor=none;fillColor=#9CA3AF;" vertex="1" parent="1"><mxGeometry x="189" y="166" width="2" height="560" as="geometry"/></mxCell><mxCell id="c7" value="" style="html=1;strokeColor=none;fillColor=#9CA3AF;" vertex="1" parent="1"><mxGeometry x="619" y="166" width="2" height="560" as="geometry"/></mxCell><mxCell id="c8" value="" style="html=1;strokeColor=none;fillColor=#9CA3AF;" vertex="1" parent="1"><mxGeometry x="1059" y="166" width="2" height="560" as="geometry"/></mxCell><mxCell id="c9" value="POST /api/distributions  {request_id, items: [{item_id, qty}]}" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="210" as="sourcePoint"/><mxPoint x="620" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="1" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="201" y="183" width="22" height="22" as="geometry"/></mxCell><mxCell id="c11" value="BEGIN" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="260" as="sourcePoint"/><mxPoint x="1060" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="2" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="631" y="233" width="22" height="22" as="geometry"/></mxCell><mxCell id="c13" value="SELECT … FROM lots WHERE item_id = ? AND qty_on_hand &amp;gt; 0&lt;br&gt;ORDER BY expires_on  FOR UPDATE      (oldest first + row lock)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="320" as="sourcePoint"/><mxPoint x="1060" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="3" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="631" y="283" width="22" height="22" as="geometry"/></mxCell><mxCell id="c15" value="locked lots, soonest-expiring first" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="375" as="sourcePoint"/><mxPoint x="620" y="375" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="4" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1027" y="348" width="22" height="22" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Enough stock across those lots?&lt;/b&gt;&lt;br&gt;NO → ROLLBACK, reply 409 Conflict “only N left” (nothing saved)&lt;br&gt;YES → continue" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="634" y="400" width="400" height="66" as="geometry"/></mxCell><mxCell id="c18" value="UPDATE lots SET qty_on_hand = qty_on_hand − n     (CHECK qty_on_hand ≥ 0)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="500" as="sourcePoint"/><mxPoint x="1060" y="500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="5" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="631" y="473" width="22" height="22" as="geometry"/></mxCell><mxCell id="c20" value="INSERT distributions, distribution_lines, inventory_txns, audit_log&lt;br&gt;UPDATE requests SET status = &amp;#x27;COMPLETED&amp;#x27;" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="560" as="sourcePoint"/><mxPoint x="1060" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="6" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="631" y="523" width="22" height="22" as="geometry"/></mxCell><mxCell id="c22" value="COMMIT   (all of steps 5–6 become visible at once)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="620" as="sourcePoint"/><mxPoint x="1060" y="620" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="7" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="631" y="593" width="22" height="22" as="geometry"/></mxCell><mxCell id="c24" value="201 Created + receipt (items, lots, quantities)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="680" as="sourcePoint"/><mxPoint x="190" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="8" style="ellipse;html=1;fillColor=#1F2933;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="587" y="653" width="22" height="22" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;THE INVARIANT&lt;/b&gt;&lt;br&gt;For every lot, at every moment:&lt;br&gt;  0 ≤ qty_on_hand&lt;br&gt;  qty_on_hand = Σ inventory_txns.delta&lt;br&gt;&lt;br&gt;Enforced three independent ways:&lt;br&gt;&lt;br&gt;1)  Row lock (FOR UPDATE): if two staff&lt;br&gt;     hand out the last box at the same&lt;br&gt;     time, the second one waits, then&lt;br&gt;     sees 0 and gets 409 — no double sale.&lt;br&gt;&lt;br&gt;2)  CHECK constraint: the database itself&lt;br&gt;     refuses a negative number, even if&lt;br&gt;     our code has a bug.&lt;br&gt;&lt;br&gt;3)  One transaction: stock change and&lt;br&gt;     distribution record are saved&lt;br&gt;     together or not at all." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1210" y="100" width="350" height="330" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;FEFO = First Expired, First Out&lt;/b&gt;&lt;br&gt;The API picks lots by soonest expiry&lt;br&gt;date, which directly serves the&lt;br&gt;proposal’s goal of reducing food waste&lt;br&gt;(P §6)." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1210" y="450" width="350" height="110" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;Black arrow = a call;  grey arrow = the reply;  vertical grey lines = each participant over time.&lt;br&gt;This diagram is the answer to “what happens if two people take the last item at once?”" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1000" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Data model" id="a0cea547fd3954899076"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Data model — PostgreSQL tables shared by all four options" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=24;align=left;verticalAlign=top;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c2" value="PK = primary key · FK = foreign key (link to another table) · labels show cardinality, e.g. 1 — N = one row links to many rows" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=top;fontStyle=0;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;email  UNIQUE&lt;br&gt;password_hash  (argon2)&lt;br&gt;role  student | staff | admin&lt;br&gt;is_active&lt;br&gt;created_at" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="340" height="122" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;student_profiles&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;user_id  FK → users   (NULL = provisional)&lt;br&gt;student_id_no  UNIQUE&lt;br&gt;full_name&lt;br&gt;verified_by  FK → users (staff)&lt;br&gt;verified_at" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="340" height="122" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;audit_log&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;actor_id  FK → users&lt;br&gt;action  e.g. request.approve&lt;br&gt;entity, entity_id&lt;br&gt;details  JSON&lt;br&gt;at  (timestamp)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="340" height="122" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;pickup_slots&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;starts_at, ends_at&lt;br&gt;capacity  CHECK &amp;gt; 0" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="340" height="77" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;requests&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;student_profile_id  FK&lt;br&gt;slot_id  FK  (NULL for walk-in)&lt;br&gt;status  SUBMITTED | APPROVED | …&lt;br&gt;note&lt;br&gt;decided_by  FK → users, decided_at&lt;br&gt;created_at" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="430" y="260" width="340" height="137" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;distributions&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;request_id  FK  UNIQUE&lt;br&gt;student_profile_id  FK&lt;br&gt;staff_id  FK → users&lt;br&gt;distributed_at" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="430" y="560" width="340" height="107" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;items  (catalog)&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;name, category&lt;br&gt;unit  e.g. can, box, lb&lt;br&gt;low_stock_threshold" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#B26B00;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="340" height="92" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;lots  (physical stock)&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;item_id  FK&lt;br&gt;donation_id  FK  (NULL = purchased)&lt;br&gt;qty_on_hand  CHECK ≥ 0&lt;br&gt;received_on, expires_on&lt;br&gt;location  shelf / bin" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#B26B00;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="820" y="270" width="340" height="122" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;distribution_lines&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;distribution_id  FK&lt;br&gt;lot_id  FK&lt;br&gt;qty  CHECK &amp;gt; 0" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="820" y="560" width="340" height="92" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;donors&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;name&lt;br&gt;type  person | org | food drive&lt;br&gt;contact  (optional)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#6A4A9C;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1210" y="100" width="340" height="92" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;donations&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;donor_id  FK&lt;br&gt;received_on&lt;br&gt;recorded_by  FK → users" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#6A4A9C;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1210" y="280" width="340" height="92" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;inventory_txns  (the ledger)&lt;/b&gt;&lt;hr&gt;id  PK&lt;br&gt;lot_id  FK&lt;br&gt;delta  + or −&lt;br&gt;reason  donation | distribution |&lt;br&gt;           adjustment | expired&lt;br&gt;ref_id, by_user, at" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=0;fillColor=#FFFFFF;strokeColor=#B26B00;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1210" y="560" width="340" height="122" as="geometry"/></mxCell><mxCell id="c15" value="1 — 0..1" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="1 — N" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="28" y="160"/><mxPoint x="28" y="650"/></Array></mxGeometry></mxCell><mxCell id="c17" value="1 — N" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="380"/><mxPoint x="430" y="380"/></Array></mxGeometry></mxCell><mxCell id="c18" value="1 — N" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="1 — 0..1" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="1 — N" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="610"/><mxPoint x="820" y="610"/></Array></mxGeometry></mxCell><mxCell id="c21" value="1 — N" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="1 — N" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="1 — N" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="1 — N" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="1 — N" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1185" y="420"/><mxPoint x="1185" y="610"/><mxPoint x="1210" y="610"/></Array></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;Design notes&lt;/b&gt;&lt;br&gt;Items vs. lots: an item is “canned beans”; a lot is one delivery of it with its own expiry date and shelf. Expiry and FEFO only work at lot level.&lt;br&gt;qty_on_hand is a fast running total; inventory_txns is the ledger that explains every change. A test checks that both always agree." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=4;fillColor=#FFFDF2;strokeColor=#C9B458;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1520" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>