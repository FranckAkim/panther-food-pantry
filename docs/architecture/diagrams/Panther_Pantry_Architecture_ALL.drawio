wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=top;fontStyle=0;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c3" value="CLIENT — user devices" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=3;fillColor=#EEF4FF;strokeColor=#3E6AA8;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#3E6AA8;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="300" height="504" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Student&lt;/b&gt;&lt;br&gt;phone / laptop" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="56" y="170" width="122" height="64" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Staff / Admin&lt;/b&gt;&lt;br&gt;desk tablet" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="56" y="290" width="122" height="64" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;React SPA&lt;/b&gt;&lt;br&gt;(Vite build)&lt;br&gt;&lt;br&gt;uses the&lt;br&gt;supabase-js&lt;br&gt;client library&lt;br&gt;&lt;br&gt;holds a JWT&lt;br&gt;after sign-in&lt;br&gt;&lt;br&gt;talks to&lt;br&gt;Supabase&lt;br&gt;directly" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="198" y="150" width="126" height="450" as="geometry"/></mxCell><mxCell id="c7" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1F2933;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="Supabase project — vendor-managed; RLS policies are the security boundary" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=2;fillColor=none;strokeColor=#C0392B;dashed=1;dashPattern=3 3;strokeWidth=1.8;verticalAlign=bottom;align=right;spacingRight=10;spacingBottom=2;fontSize=11;fontStyle=2;fontColor=#C0392B;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="1160" height="380" as="geometry"/></mxCell><mxCell id="c10" value="APPLICATION — Supabase services (no custom server)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=3;fillColor=#EDF7EE;strokeColor=#2F7D3A;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#2F7D3A;" vertex="1" parent="1"><mxGeometry x="426" y="116" width="488" height="336" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Supabase Auth&lt;/b&gt;&lt;br&gt;email + password → signed JWT with user id + role claim" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="446" y="150" width="448" height="56" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;PostgREST — auto-generated REST API&lt;/b&gt;&lt;br&gt;/rest/v1/&amp;lt;table&amp;gt;  ·  /rest/v1/rpc/&amp;lt;function&amp;gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="446" y="236" width="448" height="60" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Edge Function  notify-student  (TypeScript / Deno)&lt;/b&gt;&lt;br&gt;called by the database webhook; calls the email API" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2F7D3A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="446" y="370" width="448" height="60" as="geometry"/></mxCell><mxCell id="c14" value="DATA — Supabase Postgres" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=3;fillColor=#FFF5E6;strokeColor=#B26B00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#B26B00;" vertex="1" parent="1"><mxGeometry x="980" y="116" width="580" height="336" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;same tables as&lt;br&gt;Options A and B" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;shape=cylinder3;boundedLbl=1;size=12;fillColor=#FFFFFF;strokeColor=#B26B00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="146" width="230" height="160" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Row-Level Security policies&lt;/b&gt;&lt;br&gt;student: only own rows&lt;br&gt;staff: all operational rows" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B26B00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="146" width="250" height="84" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;SQL function&lt;/b&gt;&lt;br&gt;record_distribution()&lt;br&gt;locks lots · decrements ·&lt;br&gt;inserts lines — 1 transaction" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B26B00;strokeWidth=1.5;fontSiz