eight="18" as="geometry"/></mxCell><mxCell id="c57" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=3;fillColor=#FFF5E6;strokeColor=#B26B00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#B26B00;" vertex="1" parent="1"><mxGeometry x="1350" y="776" width="28" height="20" as="geometry"/></mxCell><mxCell id="c58" value="Data tier" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontStyle=0;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1388" y="777" width="180" height="18" as="geometry"/></mxCell><mxCell id="c59" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=3;fillColor=#F3EEFA;strokeColor=#6A4A9C;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#6A4A9C;" vertex="1" parent="1"><mxGeometry x="1350" y="806" width="28" height="20" as="geometry"/></mxCell><mxCell id="c60" value="External / managed services" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;fontStyle=0;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1388" y="807" width="180" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Option D — Serverless, event-driven (AWS)" id="7503eee486b05bb48aa2"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Option D — Serverless and event-driven on AWS: SPA + API Gateway + Lambda + RDS PostgreSQL + EventBridge" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=24;align=left;verticalAlign=top;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c2" value="No servers to run; each API module is a function · events decouple notifications and scheduled jobs · most moving parts of the four options" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;text;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=top;fontStyle=0;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c3" value="CLIENT — user devices" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=3;fillColor=#EEF4FF;strokeColor=#3E6AA8;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#3E6AA8;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="300" height="384" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Student&lt;/b&gt;&lt;br&gt;phone / laptop" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="56" y="170" width="122" height="64" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Staff / Admin&lt;/b&gt;&lt;br&gt;desk tablet" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="56" y="290" width="122" height="64" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;React SPA&lt;/b&gt;&lt;br&gt;(Vite build)&lt;br&gt;&lt;br&gt;holds a&lt;br&gt;Cognito JWT&lt;br&gt;&lt;br&gt;calls API&lt;br&gt;Gateway" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3E6AA8;strokeWidth=1.5;f